{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dc-dispatch-auth",
  "main": "src/index.js",
  "compatibility_date": "2026-11-03",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGIN": "https://dctruckingjamaica.github.io"
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "202611041",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}